{
  "name": "send",
  "description": "File Sharing Experiment",
  "version": "3.5.1",
  "author": "Mozilla (https://mozilla.org)",
  "contributors": [
    "Tim Visee <3a4fb3964f@sinenomine.email> (https://timvisee.com)"
  ],
  "repository": "gitlab:timvisee/send",
  "homepage": "https://gitlab.com/timvisee/send/",
  "license": "MPL-2.0",
  "private": true,
  "scripts": {
    "clean": "rimraf dist dist-server",
    "build": "npm run clean && npm run build:frontend && npm run build:server",
    "build:frontend": "webpack",
    "build:server": "esbuild server/bin/prod.ts --bundle --platform=node --target=node26 --format=cjs --outfile=dist-server/server.js --sourcemap --sources-content=false --minify --keep-names --legal-comments=eof --log-level=warning",
    "typecheck": "tsc -p .",
    "lint": "npm-run-all lint:*",
    "lint:css": "stylelint 'app/*.css' 'app/**/*.css'",
    "lint:ts": "eslint --max-warnings=0 .",
    "lint:format": "prettier --check .",
    "lint:types": "tsc -p .",
    "lint-locales": "node scripts/lint-locales",
    "lint-locales:dev": "npm run lint-locales",
    "lint-locales:prod": "npm run lint-locales -- --production",
    "format": "prettier --write .",
    "get-prod-locales": "node scripts/get-prod-locales",
    "get-prod-locales:write": "npm run get-prod-locales -- --write",
    "contributors": "git shortlog -s | awk -F\\t '{print $2}' > CONTRIBUTORS",
    "release": "npm-run-all contributors changelog",
    "test": "npm-run-all test:backend test:frontend",
    "test:backend": "mocha --require tsx/cjs --extension ts --reporter min 'test/backend/*-tests.ts'",
    "test:frontend": "cross-env NODE_ENV=development tsx test/frontend/runner.ts",
    "test:coverage": "c8 --reporter=text --reporter=lcov --include 'server/**' --include 'app/**' --include 'common/**' npm run test:backend",
    "test:smoke": "node test/smoke/smoke.mts",
    "start": "npm run clean && cross-env NODE_ENV=development L10N_DEV=true BASE_URL=http://localhost:8080 DETECT_BASE_URL=true webpack-dev-server --mode=development",
    "android": "cross-env ANDROID=1 npm start",
    "prod": "node --enable-source-maps dist-server/server.js"
  },
  "engines": {
    "node": ">=26.12.1"
  },
