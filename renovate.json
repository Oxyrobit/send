{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "customManagers:dockerfileVersions",
    "customManagers:githubActionsVersions"
  ],
  "timezone": "Europe/Paris",
  "baseBranchPatterns": ["master"],
  "dependencyDashboard": true,
  "labels": ["renovate"],
  "gitAuthor": "Renovate Bot <15943467+Oxyrobit@users.noreply.github.com>",
  "rebaseWhen": "behind-base-branch",
  "prHourlyLimit": 0,
  "prConcurrentLimit": 10,
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": false,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "description": "Une seule PR pour toutes les mises à jour minor/patch/digest ; les majors restent séparées",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "dépendances mineures",
      "groupSlug": "minor-patch"
    },
    {
      "description": "Actions GitHub groupées",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Node : uniquement les versions LTS (majeures paires), même version en CI et dans l'image",
      "matchPackageNames": ["node"],
      "allowedVersions": "/^\\d*[02468]\\./",
      "groupName": "node"
    },
    {
      "description": "Versions en ARG/variables de workflow : pas de digest possible",
      "matchManagers": ["custom.regex"],
      "pinDigests": false
    },
    {
      "description": "Majeures sans fusion auto : le front reste sur webpack 4/babel 7, le serveur sur express 4 (migrations à faire à la main) ; TypeScript bloqué en 6 tant que typescript-eslint ne supporte pas la 7",
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}
